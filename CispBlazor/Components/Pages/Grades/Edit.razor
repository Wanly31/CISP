@page "/grades/edit/{Id:int?}"
@rendermode InteractiveServer
@inject StudentContext Db
@inject NavigationManager Nav

<PageTitle>@title</PageTitle>

<h2>@title</h2>

<EditForm Model="grade" OnValidSubmit="Save" style="max-width: 500px">
    <DataAnnotationsValidator />

    <div class="mb-2">
        <label class="form-label">Студент</label>
        <InputSelect @bind-Value="grade.StudentId" class="form-select">
            @foreach (var s in students)
            {
                <option value="@s.Id">@s.LastName @s.FirstName</option>
            }
        </InputSelect>
    </div>
    <div class="mb-2">
        <label class="form-label">Предмет</label>
        <InputSelect @bind-Value="grade.SubjectId" class="form-select">
            @foreach (var s in subjects)
            {
                <option value="@s.Id">@s.SubjectName</option>
            }
        </InputSelect>
    </div>
    <div class="mb-2">
        <label class="form-label">Дата іспиту</label>
        <InputDate @bind-Value="grade.ExamDate" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Оцінка</label>
        <InputNumber @bind-Value="grade.Grade" class="form-control" />
        <ValidationMessage For="() => grade.Grade" class="text-danger" />
    </div>

    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a href="grades" class="btn btn-secondary">Назад</a>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private Models.Grades grade = new();
    private List<Models.Students> students = new();
    private List<Models.Subjects> subjects = new();

    private string title => grade.Id == 0 ? "Нова оцінка" : "Редагування оцінки";

    protected override void OnInitialized()
    {
        if (Id != null)
        {
            var found = Db.Grades.AsNoTracking().FirstOrDefault(g => g.Id == Id);
            if (found == null)
            {
                Nav.NotFound();
                return;
            }
            grade = found;
        }

        students = Db.Students.AsNoTracking().OrderBy(s => s.LastName).ToList();
        subjects = Db.Subjects.AsNoTracking().OrderBy(s => s.SubjectName).ToList();
        if (grade.StudentId == 0 && students.Count > 0) grade.StudentId = students[0].Id;
        if (grade.SubjectId == 0 && subjects.Count > 0) grade.SubjectId = subjects[0].Id;
    }

    private void Save()
    {
        if (grade.Id == 0) Db.Grades.Add(grade);
        else Db.Grades.Update(grade);
        Db.SaveChanges();
        Db.ChangeTracker.Clear();
        Nav.NavigateTo("grades");
    }
}
