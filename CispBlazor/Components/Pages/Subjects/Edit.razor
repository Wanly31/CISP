@page "/subjects/edit/{Id:int?}"
@rendermode InteractiveServer
@inject StudentContext Db
@inject NavigationManager Nav

<PageTitle>@title</PageTitle>

<h2>@title</h2>

<EditForm Model="subject" OnValidSubmit="Save" style="max-width: 500px">
    <DataAnnotationsValidator />

    <div class="mb-2">
        <label class="form-label">Назва</label>
        <InputText @bind-Value="subject.SubjectName" class="form-control" />
        <ValidationMessage For="() => subject.SubjectName" class="text-danger" />
    </div>
    <div class="mb-3">
        <label class="form-label">Викладач</label>
        <InputSelect @bind-Value="subject.TeacherId" class="form-select">
            @foreach (var t in teachers)
            {
                <option value="@t.Id">@t.LastName @t.FirstName</option>
            }
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a href="subjects" class="btn btn-secondary">Назад</a>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private Models.Subjects subject = new();
    private List<Models.Teachers> teachers = new();

    private string title => subject.Id == 0 ? "Новий предмет" : "Редагування предмета";

    protected override void OnInitialized()
    {
        if (Id != null)
        {
            var found = Db.Subjects.AsNoTracking().FirstOrDefault(s => s.Id == Id);
            if (found == null)
            {
                Nav.NotFound();
                return;
            }
            subject = found;
        }

        teachers = Db.Teachers.AsNoTracking().OrderBy(t => t.LastName).ToList();
        if (subject.TeacherId == 0 && teachers.Count > 0) subject.TeacherId = teachers[0].Id;
    }

    private void Save()
    {
        if (subject.Id == 0) Db.Subjects.Add(subject);
        else Db.Subjects.Update(subject);
        Db.SaveChanges();
        Db.ChangeTracker.Clear();
        Nav.NavigateTo("subjects");
    }
}
