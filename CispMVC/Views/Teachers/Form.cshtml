@model Teachers
@{
    ViewData["Title"] = Model.Id == 0 ? "Новий викладач" : "Редагування викладача";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Save" method="post" style="max-width: 500px">
    <input type="hidden" asp-for="Id" />

    <div class="mb-2">
        <label asp-for="LastName" class="form-label">Прізвище</label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="FirstName" class="form-label">Ім'я</label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MiddleName" class="form-label">По батькові</label>
        <input asp-for="MiddleName" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>
