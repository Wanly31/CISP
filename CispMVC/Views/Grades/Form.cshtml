@model Grades
@{
    ViewData["Title"] = Model.Id == 0 ? "Нова оцінка" : "Редагування оцінки";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Save" method="post" style="max-width: 500px">
    <input type="hidden" asp-for="Id" />

    <div class="mb-2">
        <label asp-for="StudentId" class="form-label">Студент</label>
        <select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select"></select>
    </div>
    <div class="mb-2">
        <label asp-for="SubjectId" class="form-label">Предмет</label>
        <select asp-for="SubjectId" asp-items="ViewBag.Subjects" class="form-select"></select>
    </div>
    <div class="mb-2">
        <label asp-for="ExamDate" class="form-label">Дата іспиту</label>
        <input asp-for="ExamDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Grade" class="form-label">Оцінка</label>
        <input asp-for="Grade" class="form-control" />
        <span asp-validation-for="Grade" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>
