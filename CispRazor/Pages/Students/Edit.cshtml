@page "{id:int?}"
@model CispRazor.Pages.Students.EditModel
@{
    ViewData["Title"] = Model.Student.Id == 0 ? "Новий студент" : "Редагування студента";
}

<h2>@ViewData["Title"]</h2>

<form method="post" style="max-width: 500px">
    <input type="hidden" asp-for="Student.Id" />

    <div class="mb-2">
        <label asp-for="Student.LastName" class="form-label">Прізвище</label>
        <input asp-for="Student.LastName" class="form-control" />
        <span asp-validation-for="Student.LastName" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Student.FirstName" class="form-label">Ім'я</label>
        <input asp-for="Student.FirstName" class="form-control" />
        <span asp-validation-for="Student.FirstName" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Student.MiddleName" class="form-label">По батькові</label>
        <input asp-for="Student.MiddleName" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Student.Address" class="form-label">Адреса</label>
        <input asp-for="Student.Address" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Student.Phone" class="form-label">Телефон</label>
        <input asp-for="Student.Phone" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Student.BirthDate" class="form-label">Дата народження</label>
        <input asp-for="Student.BirthDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Student.Scholarship" class="form-label">Стипендія</label>
        <input asp-for="Student.Scholarship" class="form-control" />
        <span asp-validation-for="Student.Scholarship" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
