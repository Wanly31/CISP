@page
@model CispRazor.Pages.Subjects.IndexModel
@{
    ViewData["Title"] = "Предмети";
}

<h2>Предмети</h2>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<a asp-page="Edit" class="btn btn-primary mb-3">Додати</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Назва</th>
            <th>Викладач</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.Subjects)
        {
            <tr>
                <td>@s.SubjectName</td>
                <td>@s.Teacher?.LastName @s.Teacher?.FirstName</td>
                <td class="text-nowrap">
                    <a asp-page="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Редагувати</a>
                    <form asp-page-handler="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Видалити?')">
                        <button class="btn btn-sm btn-outline-danger">Видалити</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
