@page "{id:int?}"
@model CispRazor.Pages.Teachers.EditModel
@{
    ViewData["Title"] = Model.Teacher.Id == 0 ? "Новий викладач" : "Редагування викладача";
}

<h2>@ViewData["Title"]</h2>

<form method="post" style="max-width: 500px">
    <input type="hidden" asp-for="Teacher.Id" />

    <div class="mb-2">
        <label asp-for="Teacher.LastName" class="form-label">Прізвище</label>
        <input asp-for="Teacher.LastName" class="form-control" />
        <span asp-validation-for="Teacher.LastName" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Teacher.FirstName" class="form-label">Ім'я</label>
        <input asp-for="Teacher.FirstName" class="form-control" />
        <span asp-validation-for="Teacher.FirstName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Teacher.MiddleName" class="form-label">По батькові</label>
        <input asp-for="Teacher.MiddleName" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
